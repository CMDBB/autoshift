   "fieldtype": "Section Break",
   "label": "Implementation"
  },
  {
   "depends_on": "eval:doc.implementation_type==\"Built-in\"",
   "description": "Key of a rule registered in autoshift.optimizer.rules.BUILTIN_RULES (rule ships in the app code).",
   "fieldname": "builtin_key",
   "fieldtype": "Data",
   "label": "Built-in Key",
   "mandatory_depends_on": "eval:doc.implementation_type==\"Built-in\""
  },
  {
   "depends_on": "eval:doc.implementation_type==\"Custom Code\"",
   "description": "Python source defining apply(ctx). ctx is autoshift.optimizer.rules.RuleContext with prob (pulp.LpProblem), x (binary vars keyed by (employee, shift, day, branch)), active_rooms (integer vars keyed by (discipline, shift, day, branch)) and data (DataPackage). pulp and itertools are pre-imported.",
   "fieldname": "implementation_code",
   "fieldtype": "Code",
   "label": "Implementation Code",
   "mandatory_depends_on": "eval:doc.implementation_type==\"Custom Code\"",
   "options": "Python"
  }
